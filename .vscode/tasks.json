{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Tauri Development Mode",
            "type": "shell",
            "command": "cargo tauri dev",
            "options": {
                "env": {
                    "CARGO_TARGET_DIR": "${workspaceFolder}/build/cargo-target"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
        },
        {
            "label": "Build Tauri Production Mode",
            "type": "shell",
            "command": "cargo tauri build",
            "options": {
                "env": {
                    "CARGO_TARGET_DIR": "${workspaceFolder}/build/cargo-target"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
        },
        {
            "label": "Build Command Line Only Debug",
            "type": "shell",
            "command": "cargo tauri dev -- -- --headless",
            "options": {
                "env": {
                    "CARGO_TARGET_DIR": "${workspaceFolder}/build/cargo-target"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
        },
        {
            "label": "Run Rust Unit Tests",
            "type": "shell",
            "command": "cargo test --manifest-path src-tauri/Cargo.toml",
            "options": {
                "env": {
                    "CARGO_TARGET_DIR": "${workspaceFolder}/build/cargo-target"
                }
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
        },
        {
            "label": "Build and Run Test Harness Executable",
            "type": "shell",
            "command": "cargo run --manifest-path src-tauri/Cargo.toml --bin test_runner -- \"${workspaceFolder}/test\"",
            "options": {
                "env": {
                    "CARGO_TARGET_DIR": "${workspaceFolder}/build/cargo-target"
                }
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
        }
    ]
}
