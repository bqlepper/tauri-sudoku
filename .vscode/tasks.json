{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Tauri Development Mode",
            "type": "shell",
            "command": "cargo tauri dev",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
        },
        {
            "label": "Build Tauri Production Mode",
            "type": "shell",
            "command": "cargo tauri build",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
        },
        {
            "label": "Build Command Line Only Debug",
            "type": "shell",
            "command": "cargo tauri dev -- -- --cli",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
        }
    ]
}